{
  "name": "Lead Capture Workflow",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body.data;\nconst fields = data.fields;\n\nlet rawName = null;\nlet rawEmail = null;\nlet rawMessage = null;\n\nfor (const field of fields) {\n  if (field.label == 'Full Name') {\n    rawName = field.value ? field.value : null;\n  } else if (field.label == 'Email Address') {\n    rawEmail = field.value ? field.value : null;\n  } else if (field.label == 'Message') {\n    rawMessage = field.value ? field.value : null;\n  }\n}\n// Validate email format\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst isValidEmail = rawEmail && emailRegex.test(rawEmail);\n\n// Trim and normalize\nconst name = rawName ? rawName.trim() : null;\nconst email = rawEmail ? rawEmail.trim().toLowerCase() : null;\nconst message = rawMessage ? rawMessage.trim() : '';\n\n// Split name into first/last for CRM mapping\nconst nameParts = name ? name.split(' ') : [];\nconst firstName = nameParts[0] || '';\nconst lastName = nameParts.slice(1).join(' ') || '';\n\n// Flag invalid submissions instead of silently failing\nif (!name || !email || !isValidEmail) {\n  return [{\n    json: {\n      valid: false,\n      error: !email ? 'Missing email' : !isValidEmail ? 'Invalid email format' : 'Missing name',\n      rawName,\n      rawEmail\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    firstName,\n    lastName,\n    fullName: name,\n    email,\n    message,\n    submittedAt: new Date().toISOString()\n  }\n}];"
      },
